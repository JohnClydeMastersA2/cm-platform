FROM node:24-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services
COPY tools ./tools

RUN npm ci
RUN npm run public-v2:build

FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.public-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/public-web-v2/dist /usr/share/nginx/html

EXPOSE 8080
