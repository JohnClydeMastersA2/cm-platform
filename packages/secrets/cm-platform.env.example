MSSQL_SA_PASSWORD=<local-sql-sa-password>
DB_SERVER=localhost
DB_PORT=1433
DB_USER=cm_platform_app
DB_PASSWORD=<local-sql-app-password>
# DB_MIGRATION_USER=<production-migration-user>
# DB_MIGRATION_PASSWORD=<production-migration-password>
DB_DATABASE=CMPlatform
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
ADMIN_KEY=<local-admin-key>
RABBITMQ_DEFAULT_USER=cm_platform
RABBITMQ_DEFAULT_PASS=<local-rabbitmq-password>
RABBITMQ_URL=amqp://cm_platform:<local-rabbitmq-password>@localhost:5672
RABBITMQ_URL_CONTAINER=amqp://cm_platform:<local-rabbitmq-password>@rabbitmq:5672
HEALTHCARE_TRANSFORM_BASE_URL=http://localhost:8081
MONGODB_ROOT_USERNAME=cm_platform_root
MONGODB_ROOT_PASSWORD=<local-mongodb-password>
MONGODB_APP_USERNAME=cm_platform_app
MONGODB_APP_PASSWORD=<local-mongodb-app-password>
MONGODB_URI=mongodb://cm_platform_app:<local-mongodb-app-password>@localhost:27017/CMPlatformDocuments?authSource=CMPlatformDocuments
MONGODB_URI_CONTAINER=mongodb://cm_platform_app:<local-mongodb-app-password>@mongodb:27017/CMPlatformDocuments?authSource=CMPlatformDocuments
HEALTHCARE_TRANSFORM_MONGODB_DATABASE=healthcare_transform
HEALTHCARE_TRANSFORM_MONGODB_APP_USERNAME=healthcare_transform_app
HEALTHCARE_TRANSFORM_MONGODB_APP_PASSWORD=<local-healthcare-mongodb-app-password>
HEALTHCARE_TRANSFORM_MONGODB_URI=mongodb://healthcare_transform_app:<local-healthcare-mongodb-app-password>@localhost:27017/healthcare_transform?authSource=healthcare_transform
HEALTHCARE_TRANSFORM_MONGODB_URI_CONTAINER=mongodb://healthcare_transform_app:<local-healthcare-mongodb-app-password>@mongodb:27017/healthcare_transform?authSource=healthcare_transform

EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASS=<resend-api-key-for-local-dev>
RESEND_WEBHOOK_SECRET=<optional-resend-webhook-signing-secret-for-local-testing>
CM_PLATFORM_MONITORS=<monitor-email-1>,<monitor-email-2>
DEMO_MAINTENANCE_RETENTION_HOURS=24
DEMO_MAINTENANCE_API_BASE_URL=http://localhost:3000
# DEMO_MAINTENANCE_API_HOST_HEADER=cmplatform.dev
